# Generic API config. Works with Anthropic-compatible endpoints such as DeepSeek.
APIKEY=sk-your-api-key
API=https://api.deepseek.com/anthropic
MODEL=claude-sonnet-4-6

# Optional generic aliases supported by MiniAgent.
# MINI_CLAUDE_API_KEY=sk-your-api-key
# MINI_CLAUDE_API_BASE=https://api.deepseek.com/anthropic

# Anthropic native config. Disable generic API/APIKEY settings when switching providers.
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible config.
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://your-openai-compatible-host/v1
# MODEL=gpt-4o

# Skill self-evolution. Enabled by default; set to 0 to turn it off.
# MINIAGENT_AUTO_SKILL_EVOLUTION=1
# Where auto-created Skills are written: project or user.
# MINIAGENT_AUTO_SKILL_TARGET=project
